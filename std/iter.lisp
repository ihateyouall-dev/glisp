;;; iter.lisp - Higher-order functions: map, filter, reduce, each, any?, all?

(defun to-list (coll)
  (apply list coll))

(defun to-array (coll)
  (apply array coll))

(defun to-vector (coll)
  (apply vector coll))

(defun map (f coll)
  (cond
    ((nil? coll)
     nil)
    ((list? coll)
     (cons (f (car coll)) (map f (cdr coll))))
    ((vector? coll)
     (let ((res {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (push res (f (get coll i)))
         (set i (+ i 1)))
       res))
    ((array? coll)
     (let ((vec {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (push vec (f (get coll i)))
         (set i (+ i 1)))
       (apply array vec)))
    (else nil)))

(defun filter (pred coll)
  (cond
    ((nil? coll)
     nil)
    ((list? coll)
     (if (pred (car coll))
         (cons (car coll) (filter pred (cdr coll)))
         (filter pred (cdr coll))))
    ((vector? coll)
     (let ((res {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (let ((item (get coll i)))
           (if (pred item)
               (push res item)))
         (set i (+ i 1)))
       res))
    ((array? coll)
     (let ((vec {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (let ((item (get coll i)))
           (if (pred item)
               (push vec item)))
         (set i (+ i 1)))
       (apply array vec)))
    (else nil)))

(defun reduce (f coll init)
  (if (or (list? coll) (nil? coll))
      (let ((acc init)
            (cur coll))
        (while (not (nil? cur))
          (set acc (f acc (car cur)))
          (set cur (cdr cur)))
        acc)
      (let ((acc init)
            (i 0)
            (n (len coll)))
        (while (< i n)
          (set acc (f acc (get coll i)))
          (set i (+ i 1)))
        acc)))

(defun each (f coll)
  (if (or (list? coll) (nil? coll))
      (let ((cur coll))
        (while (not (nil? cur))
          (f (car cur))
          (set cur (cdr cur))))
      (let ((i 0)
            (n (len coll)))
        (while (< i n)
          (f (get coll i))
          (set i (+ i 1))))))

(defun any? (pred coll)
  (if (or (list? coll) (nil? coll))
      (if (nil? coll)
          nil
          (if (pred (car coll))
              t
              (any? pred (cdr coll))))
      (let ((i 0)
            (n (len coll))
            (found nil))
        (while (and (< i n) (not found))
          (if (pred (get coll i))
              (set found t))
          (set i (+ i 1)))
        found)))

(defun all? (pred coll)
  (if (or (list? coll) (nil? coll))
      (if (nil? coll)
          t
          (if (pred (car coll))
              (all? pred (cdr coll))
              nil))
      (let ((i 0)
            (n (len coll))
            (failed nil))
        (while (and (< i n) (not failed))
          (if (not (pred (get coll i)))
              (set failed t))
          (set i (+ i 1)))
        (not failed))))
