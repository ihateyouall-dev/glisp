;;; iter.lisp - Higher-order functions: map, filter, reduce, each, any?, all?

(defun to-list (coll)
  "Converts COLL to a list."
  (apply list coll))

(defun to-array (coll)
  "Converts COLL to a fixed array."
  (apply array coll))

(defun to-vector (coll)
  "Converts COLL to a dynamic vector."
  (apply vector coll))

(defun map (f coll)
  "Applies F to each element of COLL, preserving its collection type."
  (cond
    ((nil? coll)
     nil)
    ((list? coll)
     (let ((acc nil))
       (while coll
         (set acc (cons (f (car coll)) acc))
         (set coll (cdr coll)))
       (reverse acc)))
    ((vector? coll)
     (let ((res {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (push res (f (get coll i)))
         (set i (+ i 1)))
       res))
    ((array? coll)
     (let ((vec {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (push vec (f (get coll i)))
         (set i (+ i 1)))
       (apply array vec)))
    (else nil)))

(defun filter (pred coll)
  "Keeps elements of COLL for which PRED is true, preserving its type."
  (cond
    ((nil? coll)
     nil)
    ((list? coll)
     (let ((acc nil))
       (while coll
         (if (pred (car coll))
             (set acc (cons (car coll) acc)))
         (set coll (cdr coll)))
       (reverse acc)))
    ((vector? coll)
     (let ((res {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (let ((item (get coll i)))
           (if (pred item)
               (push res item)))
         (set i (+ i 1)))
       res))
    ((array? coll)
     (let ((vec {})
           (i 0)
           (n (len coll)))
       (while (< i n)
         (let ((item (get coll i)))
           (if (pred item)
               (push vec item)))
         (set i (+ i 1)))
       (apply array vec)))
    (else nil)))

(defun reduce (f coll init)
  "Left fold of F over COLL starting from INIT."
  (if (or (list? coll) (nil? coll))
      (let ((acc init)
            (cur coll))
        (while cur
          (set acc (f acc (car cur)))
          (set cur (cdr cur)))
        acc)
      (let ((acc init)
            (i 0)
            (n (len coll)))
        (while (< i n)
          (set acc (f acc (get coll i)))
          (set i (+ i 1)))
        acc)))

(defun each (f coll)
  "Calls F for every element of COLL and returns nil."
  (if (or (list? coll) (nil? coll))
      (let ((cur coll))
        (while cur
          (f (car cur))
          (set cur (cdr cur))))
      (let ((i 0)
            (n (len coll)))
        (while (< i n)
          (f (get coll i))
          (set i (+ i 1))))))

(defun any? (pred coll)
  "Returns t when at least one element of COLL satisfies PRED."
  (if (or (list? coll) (nil? coll))
      (let ((found nil))
        (while (and coll (not found))
          (if (pred (car coll))
              (set found t))
          (set coll (cdr coll)))
        found)
      (let ((i 0)
            (n (len coll))
            (found nil))
        (while (and (< i n) (not found))
          (if (pred (get coll i))
              (set found t))
          (set i (+ i 1)))
        found)))

(defun all? (pred coll)
  "Returns t when every element of COLL satisfies PRED."
  (if (or (list? coll) (nil? coll))
      (let ((failed nil))
        (while (and coll (not failed))
          (if (not (pred (car coll)))
              (set failed t))
          (set coll (cdr coll)))
        (not failed))
      (let ((i 0)
            (n (len coll))
            (failed nil))
        (while (and (< i n) (not failed))
          (if (not (pred (get coll i)))
              (set failed t))
          (set i (+ i 1)))
        (not failed))))

(defun sort (coll)
  "Returns a sorted copy of COLL, in ascending order."
  (if (nil? coll)
      nil
      (let ((arr (to-array coll))
            (n (len coll))
            (i 1))
        (while (< i n)
          (let ((cur (get arr i))
                (j (- i 1)))
            (while (and (>= j 0) (> (get arr j) cur))
              (set-at arr (+ j 1) (get arr j))
              (set j (- j 1)))
            (set-at arr (+ j 1) cur))
          (set i (+ i 1)))
        (cond
          ((list? coll) (to-list arr))
          ((array? coll) arr)
          (else (to-vector arr))))))
